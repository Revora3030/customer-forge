# Static asset cache rules (Cloudflare static-assets `_headers` format).
# The Nitro cloudflare-module build merges this file into the deployed
# public/_headers. File names are not content-hashed, so these are long but
# not `immutable`; replace the file name when an image changes materially.

/og.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/favicon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/revora-mark-144.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/revora-mark-144.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/revora-mark-144.avif
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/.well-known/security.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# Vite/rolldown build output: every file under /assets/ carries a content hash
# in its name (e.g. index-BuXYA5Xc.js), so a changed file always gets a new URL
# and the old one can be cached forever. HTML documents are not matched here
# and keep their existing no-cache / s-maxage rules from the worker.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Owner push-alert service worker: always revalidate.
/push-sw.js
  Cache-Control: no-cache
  Content-Type: application/javascript; charset=utf-8

# Owner dashboard service worker (vite-plugin-pwa). Always revalidate so an
# update is picked up on the next visit; the SW itself is scoped to /app/.
/sw.js
  Cache-Control: no-cache
  Content-Type: application/javascript; charset=utf-8

/app-offline.html
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow
