##############################################################################
# Revora Growth Systems — environment reference (NAMES ONLY, never real values)
#
# Copy nothing from here into a committed file. The platform manages the real
# values: `.env`, `.env.development` and `.env.production` hold only
# PUBLISHABLE client values, and every server secret below is injected at
# runtime and must never be written into the repository.
##############################################################################

# ---------------------------------------------------------------------------
# Client-side (safe to expose — shipped in the browser bundle by design)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Stripe publishable token. pk_test_... in development, pk_live_... in production.
# The app derives sandbox vs live from this prefix and refuses to guess.
VITE_PAYMENTS_CLIENT_TOKEN=

# ---------------------------------------------------------------------------
# Server-side, non-secret
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# SERVER SECRETS — runtime-injected. Never commit, never log, never send to the
# browser, never read outside a server function / server route handler.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
# ---------------------------------------------------------------------------
# Revora AI — Lovable AI is the only model provider. Server-only, never VITE_.
# The builder and Jarvis stay unavailable until LOVABLE_API_KEY is set.
# There is no second provider lane: GOOGLE_AI_API_KEY, OPENAI_API_KEY,
# AI_DEFAULT_PROVIDER and the old free-provider keys are not read by the router.
# ---------------------------------------------------------------------------
# Lovable AI gateway key. Also the key for Lovable's email connector.
LOVABLE_API_KEY=
# Optional per-role roster override. Comma-separated catalogue ids
# (vendor/model), in failover order. Leave unset to use the defaults in
# src/lib/ai/config.ts. Roles: PRIMARY, DESIGN, FAST, VISION, CODING, IMAGE,
# TRANSCRIPTION, CONVERSATION.
# AI_LOVABLE_MODEL_PRIMARY=
# AI_LOVABLE_MODEL_DESIGN=
# Optional ceilings. See aiLimits() in src/lib/ai/config.ts for the defaults.
AI_MAX_REQUESTS_PER_USER_DAY=
AI_MAX_REQUESTS_PER_WORKSPACE_DAY=
AI_MAX_REQUESTS_PER_WORKSPACE_MONTH=
# Shared daily paid cap in USD, and the monthly Luna cap (also USD).
# AI_PAID_DAILY_CAP_USD=
# LUNA_ENABLED=
# LUNA_MONTHLY_CAP_USD=
# LUNA_TENANT_MONTHLY_CAP_USD=
# Set any of these to true to refuse paid model calls (work waits).
# AI_FREE_ONLY=
# FREE_AI_ONLY=
# ZERO_COST_ONLY=
# Picture and silent section-video generation. Premium video uses the same
# Gemini Omni model as standard until a distinct catalogued model is wired.
# PAID_IMAGE_ENABLED=
# PAID_VIDEO_ENABLED=
# PAID_VIDEO_MODEL=
# PAID_VIDEO_MODEL_PREMIUM=
# PAID_VIDEO_PRICE_USD=
# Stripe connector-gateway connection keys (NOT Stripe sk_ secret keys).
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Test / CI only
# ---------------------------------------------------------------------------
# Target for the end-to-end suite. Defaults to http://localhost:8080.
E2E_BASE_URL=
# Set to 1 ONLY for a deliberate offline unit-only run. Critical payment and
# production flows otherwise FAIL when the app is unreachable, and this flag is
# ignored when CI=true so a green CI run always means the app was reached.
E2E_ALLOW_OFFLINE=
# Published tenant slug in the environment at E2E_BASE_URL. Never guess it.
E2E_TENANT_SLUG=
# Set to 1 for a production/staging tenant check that must not skip.
E2E_REQUIRE_TENANT=
# Explicit opt-in: only 1 or true permits real outbound test requests.
INTEGRATION_TESTS_ENABLED=
INTEGRATION_TEST_EMAIL_TO=
INTEGRATION_TEST_CRM_WEBHOOK_URL=
# A dedicated test workspace the receiver recognizes, plus an approved address.
INTEGRATION_TEST_CRM_ORGANIZATION_ID=
INTEGRATION_TEST_CRM_EMAIL=
INTEGRATION_TEST_CRM_PHONE=

# ---------------------------------------------------------------------------
# Optional server-side integrations. Values are deployment secrets, never VITE_.
# Presence of a value is configuration, not proof of a successful live handshake.
# ---------------------------------------------------------------------------
# The router does not call Ollama. Real optional server secrets the app does read:
# PERPLEXITY_API_KEY (Lovable search connector), PERPLEXITY_API_KEY_1 (owner pplx- key),
# ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID, RESEND_API_KEY, GOOGLE_PLACES_API_KEY,
# GOOGLE_MAPS_API_KEY, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER,
# INSTAGRAM_APP_ID, INSTAGRAM_APP_SECRET, INSTAGRAM_CREDENTIAL_SECRET,
# APP_URL, REVORA_SENDER_NAME, REVORA_REPLY_TO_EMAIL, REVORA_MAILING_ADDRESS.
SENTRY_DSN=
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# Optional server-side OTLP/Langfuse AI trace export (metadata only)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_AUTHORIZATION=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
