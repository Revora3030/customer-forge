##############################################################################
# Revora Growth Systems — environment reference (NAMES ONLY, never real values)
#
# Copy nothing from here into a committed file. The platform manages the real
# values: `.env`, `.env.development` and `.env.production` hold only
# PUBLISHABLE client values, and every server secret below is injected at
# runtime and must never be written into the repository.
##############################################################################

# ---------------------------------------------------------------------------
# Client-side (safe to expose — shipped in the browser bundle by design)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Stripe publishable token. pk_test_... in development, pk_live_... in production.
# The app derives sandbox vs live from this prefix and refuses to guess.
VITE_PAYMENTS_CLIENT_TOKEN=

# ---------------------------------------------------------------------------
# Server-side, non-secret
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# SERVER SECRETS — runtime-injected. Never commit, never log, never send to the
# browser, never read outside a server function / server route handler.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
# ---------------------------------------------------------------------------
# Revora AI — Revora's own provider accounts. Server-only, never VITE_.
# Revora AI is unavailable (and says so plainly) until at least one key is set.
# ---------------------------------------------------------------------------
# Which provider is tried first, and which one covers for it: google | openai
AI_DEFAULT_PROVIDER=google
AI_FALLBACK_PROVIDER=openai
# Optional: pin the main model. Leave blank to use Revora's defaults.
AI_DEFAULT_MODEL=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
# Optional usage ceilings (per user per day / per workspace per day / month).
AI_MAX_REQUESTS_PER_USER_DAY=
AI_MAX_REQUESTS_PER_WORKSPACE_DAY=
AI_MAX_REQUESTS_PER_WORKSPACE_MONTH=

# Transactional and auth email delivery (not AI).
LOVABLE_API_KEY=
# Stripe connector-gateway connection keys (NOT Stripe sk_ secret keys).
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Test / CI only
# ---------------------------------------------------------------------------
# Target for the end-to-end suite. Defaults to http://localhost:8080.
E2E_BASE_URL=
# Set to 1 ONLY for a deliberate offline unit-only run. Critical payment and
# production flows otherwise FAIL when the app is unreachable, and this flag is
# ignored when CI=true so a green CI run always means the app was reached.
E2E_ALLOW_OFFLINE=
# Published tenant slug in the environment at E2E_BASE_URL. Never guess it.
E2E_TENANT_SLUG=
# Set to 1 for a production/staging tenant check that must not skip.
E2E_REQUIRE_TENANT=
# Explicit opt-in: only 1 or true permits real outbound test requests.
INTEGRATION_TESTS_ENABLED=
INTEGRATION_TEST_EMAIL_TO=
INTEGRATION_TEST_CRM_WEBHOOK_URL=
# A dedicated test workspace the receiver recognizes, plus an approved address.
INTEGRATION_TEST_CRM_ORGANIZATION_ID=
INTEGRATION_TEST_CRM_EMAIL=
INTEGRATION_TEST_CRM_PHONE=

# ---------------------------------------------------------------------------
# FREE AI (optional — the builder works fully without any of these)
# ---------------------------------------------------------------------------
# Server-side only. Never prefix any of these with VITE_.
# Set them as project secrets so they reach the server runtime; they must never
# be committed, logged, or stored in the database.
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
GOOGLE_AI_FREE_API_KEY=
# Free-AI lane. Free models are an extra failover lane only; paid providers
# are always available to the AI team (there is no free-only or zero-cost mode).
FREE_AI_ENABLED=
FREE_AI_PROVIDER_ORDER=cloudflare,groq,nvidia,llm7,openrouter,google,mistral,huggingface,deepseek,cerebras,cohere
# Optional per-day request budgets so a free allowance can't be exhausted.
FREE_AI_CLOUDFLARE_DAILY_CAP=
FREE_AI_OPENROUTER_DAILY_CAP=
FREE_AI_GOOGLE_DAILY_CAP=
# Treat a general GOOGLE_AI_API_KEY as free tier (only if that project is not billed).
FREE_AI_GOOGLE_FREE_TIER=

# Groq free developer tier (free AI provider)
GROQ_API_KEY=
FREE_AI_GROQ_DAILY_CAP=

# LLM7.io free tier (free AI provider)
LLM7_API_KEY=
FREE_AI_LLM7_DAILY_CAP=

# NVIDIA NIM free developer allowance (free AI provider)
NVIDIA_NIM_API_KEY=
FREE_AI_NVIDIA_DAILY_CAP=

# Mistral AI Experiment plan (free AI provider)
MISTRAL_API_KEY=
FREE_AI_MISTRAL_DAILY_CAP=

# Hugging Face Serverless Inference free tier (free AI provider)
HUGGINGFACE_API_KEY=
FREE_AI_HUGGINGFACE_DAILY_CAP=

# DeepSeek API free developer tier (free AI provider)
DEEPSEEK_API_KEY=
FREE_AI_DEEPSEEK_DAILY_CAP=

# Cerebras free inference tier (free AI provider)
CEREBRAS_API_KEY=
FREE_AI_CEREBRAS_DAILY_CAP=

# Cohere trial API (free AI provider)
COHERE_API_KEY=
FREE_AI_COHERE_DAILY_CAP=
